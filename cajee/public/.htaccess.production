# Farida Cajee-Botes Orthotist & Prosthetist — Hostinger (Apache/LiteSpeed)

Options -Indexes

# Never serve internal files. The whole repo reaches public_html, so without
# this the site served the React source and node_modules under /cajee/,
# DEPLOY-README.txt (which names the file holding the mailbox password) and
# the git dotfiles to anyone (found with curl on 2026-09-15).
# RedirectMatch 404 returns a real 404, not a 403 that confirms a file exists.
# patient-intake/lib/ and mail-config*.php are loaded by PHP from disk
# (include/require_once), so blocking them over HTTP does not affect the form.
# FilesMatch is a second layer for mail-config*.php in case PHP ever stops
# executing; it is untested on Hostinger, so keep the RedirectMatch line.
# error_log is the file PHP hosts write next to scripts when warnings fire.
# A new public file of a blocked type (.md, .zip, .mjs) needs an exception.
# /.well-known/ stays open because SSL certificate renewal uses it.
RedirectMatch 404 ^/cajee(/|$)
RedirectMatch 404 ^/DEPLOY-README\.txt$
RedirectMatch 404 ^/patient-intake/(lib(/|$)|mail-config)
RedirectMatch 404 /node_modules(/|$)
RedirectMatch 404 (^|/)error_log$
RedirectMatch 404 /\.(?!well-known(/|$))
RedirectMatch 404 \.(md|log|bak|sql|sh|ya?ml|lock|zip|rar|tsx?|mjs)$
RedirectMatch 404 /(package(-lock)?|tsconfig)\.json$
<FilesMatch "^mail-config.*\.php$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS and the www canonical host (matches sitemap/canonical URLs)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://www.%1%{REQUEST_URI} [L,R=301]

  # Retired page: /case-studies was removed. 301 to the blog so indexed URLs
  # and any inbound links land somewhere useful instead of the SPA 404.
  RewriteRule ^case-studies/?$ /blog [R=301,L]

  # Prerendered pages live as <route>/index.html. Serve them directly without
  # mod_dir's trailing-slash 301 so canonical URLs resolve in one hop.
  <IfModule mod_dir.c>
    DirectorySlash Off
  </IfModule>
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ $1/index.html [L]
  # Normalise trailing-slash URLs to the canonical non-slash form
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.+)/$ /$1 [R=301,L]
  # Single Page App fallback: serve index.html for any path that is not a real
  # file or directory, so client-side routes (e.g. /about) work on refresh.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Gzip / Brotli compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# Caching: hashed build assets are immutable; HTML must always revalidate
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Only build-hashed filenames (name-A1b2C3d4.ext) are truly immutable. Unhashed
  # public files such as /logo.png and /og-image.jpg keep their names when their
  # contents change, so caching those for a year would strand returning visitors
  # on a stale logo. They get a short cache and revalidate instead.
  <FilesMatch "\.(?:png|jpe?g|svg|webp|gif|ico)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
  </FilesMatch>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(?:css|js|png|jpe?g|svg|webp|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

ErrorDocument 404 /index.html
